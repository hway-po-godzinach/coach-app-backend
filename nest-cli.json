{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "apps/training-program/src",
	"compilerOptions": {
		"deleteOutDir": true,
		"webpack": true,
		"tsConfigPath": "apps/training-program/tsconfig.app.json"
	},
	"projects": {
		"common": {
			"type": "library",
			"root": "libs/common",
			"entryFile": "index",
			"sourceRoot": "libs/common/src",
			"compilerOptions": {
				"tsConfigPath": "libs/common/tsconfig.lib.json"
			}
		},
		"training-program": {
			"type": "application",
			"root": "apps/training-program",
			"entryFile": "main",
			"sourceRoot": "apps/training-program/src",
			"compilerOptions": {
				"tsConfigPath": "apps/training-program/tsconfig.app.json"
			}
		}
	},
	"monorepo": true,
	"root": "apps/training-program"
}
